# Copy this file to /etc/web-teacher/web-teacher.env and edit it on the server.
# Do not commit the real production secret.

SITE_URL=https://your-domain.example
PUBLIC_MEDIA_BASE_URL=

TEACHER_SITE_REQUIRE_AUTH_SECRET=1
TEACHER_SITE_AUTH_SECRET=replace-with-a-random-secret-generated-by-openssl-or-python

TEACHER_SITE_DB=/srv/web-teacher/data/site.sqlite3
TEACHER_SITE_MEDIA=/srv/web-teacher/media
TEACHER_SITE_PUBLIC=/srv/web-teacher/public

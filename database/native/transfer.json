    },
    {
      "type": "table",
      "name": "transfer_allowances",
      "tbl_name": "transfer_allowances",
      "sql": "CREATE TABLE transfer_allowances (\n    task TEXT NOT NULL, member TEXT NOT NULL, identity_key TEXT NOT NULL, kind TEXT NOT NULL,\n    bytes TEXT NOT NULL, created_at INTEGER NOT NULL, authorized_at INTEGER,\n    expires_at INTEGER NOT NULL, finished_at INTEGER, outcome TEXT,\n    PRIMARY KEY(task, member)\n  ) STRICT"
    },
    {
      "type": "table",
      "name": "vpn_state",
      "tbl_name": "vpn_state",
      "sql": "CREATE TABLE vpn_state(id INTEGER PRIMARY KEY CHECK(id=1), document TEXT NOT NULL) STRICT"
    },
    {
      "type": "table",
      "name": "vpn_grants",
      "tbl_name": "vpn_grants",
      "sql": "CREATE TABLE vpn_grants(token_hash TEXT PRIMARY KEY, revision INTEGER NOT NULL, created_at INTEGER NOT NULL, expires_at INTEGER NOT NULL,\n      rx_max TEXT NOT NULL, tx_max TEXT NOT NULL, overhead INTEGER NOT NULL, rx_issued TEXT NOT NULL, tx_issued TEXT NOT NULL,\n      sequence INTEGER NOT NULL, closed_at INTEGER, reconciled_at INTEGER) STRICT"
    },
    {
      "type": "table",
      "name": "vpn_audit",
      "tbl_name": "vpn_audit",
      "sql": "CREATE TABLE vpn_audit(id INTEGER PRIMARY KEY, at INTEGER NOT NULL, actor TEXT NOT NULL, action TEXT NOT NULL, details TEXT NOT NULL) STRICT"
    },
    {
      "type": "table",
      "name": "temporary_shares",
      "tbl_name": "temporary_shares",
      "sql": "CREATE TABLE temporary_shares(id TEXT PRIMARY KEY,owner TEXT NOT NULL,secret_hash TEXT UNIQUE NOT NULL,summary TEXT NOT NULL,manifest TEXT,reserved_bytes TEXT NOT NULL,state TEXT NOT NULL,created_at INTEGER NOT NULL,expires_at INTEGER NOT NULL,max_downloads INTEGER NOT NULL,downloads INTEGER NOT NULL DEFAULT 0,note TEXT NOT NULL) STRICT"
    },
    {
      "type": "table",
      "name": "recovery_tasks",
      "tbl_name": "recovery_tasks",
      "sql": "CREATE TABLE recovery_tasks(id TEXT PRIMARY KEY,transport TEXT NOT NULL,summary TEXT NOT NULL,note TEXT NOT NULL,point TEXT NOT NULL,extra TEXT NOT NULL,state TEXT NOT NULL,expires_at INTEGER NOT NULL,updated_at INTEGER NOT NULL) STRICT"
    },
    {
      "type": "table",
      "name": "recovery_members",
      "tbl_name": "recovery_members",
      "sql": "CREATE TABLE recovery_members(task TEXT NOT NULL REFERENCES recovery_tasks(id) ON DELETE CASCADE,member TEXT NOT NULL,identity_key TEXT NOT NULL,token_hash TEXT UNIQUE NOT NULL,PRIMARY KEY(task,member)) STRICT"

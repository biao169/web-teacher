# Place this location inside the existing HTTPS teacher-site server block.
# Replace the teacher upstream port if needed. Keep the tool service on loopback.
# The tool Nuxt module forwards this route to the configured independent service.
# Existing proxy rules may already implement these WebSocket headers.
# Step 8 carries bounded file envelopes on this same authenticated WebSocket.
# Verify the browser-to-teacher AND teacher-to-tool paths for VPN classification.
# Keep this route through Nuxt; do not bypass the live identity bridge.
location = /transfer-api/v1/signal {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    proxy_buffering off;
}
# All other /transfer-api/ requests must continue through the teacher site.
# Do not proxy ticket/admin/session endpoints directly to the independent tool:
# the teacher side supplies live identity, same-origin and CSRF verification.

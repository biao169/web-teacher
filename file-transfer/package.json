{
  "name": "academic-file-transfer",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Independent file transfer service \u2014 milestone 10 operations and release verification",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node --watch scripts/start.mjs",
    "health": "node scripts/health.mjs",
    "check:config": "node scripts/check-config.mjs",
    "test": "node --test --test-reporter=spec tests/*.test.mjs",
    "initialize": "node scripts/initialize-bridge.mjs",
    "teacher:dev": "node scripts/teacher.mjs dev",
    "teacher:build": "node scripts/teacher.mjs build",
    "teacher:start": "node scripts/teacher.mjs start",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/maintenance.mjs backup",
    "verify:backup": "node scripts/maintenance.mjs verify",
    "restore:backup": "node scripts/maintenance.mjs restore",
    "build": "vite build --config standalone/vite.config.mjs",
    "start:standalone": "node scripts/standalone.mjs",
    "dev:standalone": "vite --config standalone/vite.config.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "check:cloudflare": "wrangler deploy --dry-run",
    "admin:init": "node scripts/standalone-admin.mjs"
  },
  "dependencies": {
    "qrcode-generator": "2.0.4",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "@vitejs/plugin-vue": "6.0.8",
    "vue": "3.5.42",
    "vue-router": "5.3.0",
    "ofetch": "1.5.1",
    "wrangler": "4.126.0"
  }
}

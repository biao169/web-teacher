{
  "name": "teacher-sync-engine",
  "main": "../sync_entry.py",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_DATABASE_NAME",
      "database_id": "REPLACE_DATABASE_ID"
    }
  ],
  "services": [
    {
      "binding": "NATIVE",
      "service": "teacher-sync-native"
    }
  ],
  "vars": {
    "SYNC_ENABLED": "0",
    "WEBSITE_ADAPTER": "site_sync.runtime.mapping:MappedWebsite",
    "WEBSITE_ADAPTER_CONFIG": "{}",
    "SYNC_HISTORY_DAYS": "90"
  },
  "observability": {
    "enabled": false
  }
}

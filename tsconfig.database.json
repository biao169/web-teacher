{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true
  },
  "include": [
    "db/*.ts",
    "db/adapters/*.ts",
    "tests/contracts/*.ts"
  ],
  "exclude": [
    "db/schema.ts",
    "db/security-schema.ts",
    "db/cache-schema.ts",
    "db/interaction-schema.ts"
  ]
}

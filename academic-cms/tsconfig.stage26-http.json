{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "ES2022.Intl"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "."
  },
  "include": [
    "tests/types/offline-runtime.d.ts",
    "tests/types/stage3-http-runtime.d.ts",
    "server/types/h3.d.ts",
    "db/contracts.ts",
    "db/query.ts",
    "db/errors.ts",
    "db/statement.ts",
    "db/codec.ts",
    "db/catalog.ts",
    "db/models.ts",
    "db/schema-types.ts",
    "db/context.ts",
    "db/repository.ts",
    "db/read-plans.ts",
    "db/adapters/sqlite.ts",
    "db/adapters/d1.ts",
    "shared/enums/*.ts",
    "shared/contracts/*.ts",
    "shared/utils/*.ts",
    "shared/admin/*.ts",
    "server/security/*.ts",
    "server/audit/*.ts",
    "server/services/auth/*.ts",
    "server/services/admin/*.ts",
    "server/utils/database.ts",
    "server/utils/auth-runtime.ts",
    "server/utils/auth-http.ts",
    "server/utils/auth-guard.ts",
    "server/utils/bounded-json.ts",
    "server/utils/admin-http.ts",
    "server/utils/admin-read-handler.ts",
    "server/utils/admin-write-handler.ts",
    "server/utils/admin-handler.ts",
    "server/routes/api/v1/admin/**/*.ts"
  ]
}

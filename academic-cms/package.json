{
  "name": "academic-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "postinstall": "nuxt prepare",
    "build": "pnpm run build:ubuntu",
    "build:ubuntu": "node scripts/build-target.mjs ubuntu",
    "build:cloudflare": "node scripts/build-target.mjs cloudflare",
    "start": "node scripts/run-built-target.mjs start-ubuntu",
    "preview:ubuntu": "pnpm run build:ubuntu && node scripts/run-built-target.mjs start-ubuntu",
    "preview:cloudflare": "pnpm run build:cloudflare && node scripts/run-built-target.mjs preview-cloudflare",
    "deploy:cloudflare": "pnpm run build:cloudflare && node scripts/run-built-target.mjs deploy-cloudflare",
    "smoke:ubuntu": "node scripts/smoke-runtime.mjs ubuntu",
    "smoke:cloudflare": "node scripts/smoke-runtime.mjs cloudflare",
    "acceptance:ubuntu": "pnpm run build:ubuntu && pnpm run smoke:ubuntu",
    "acceptance:cloudflare": "pnpm run build:cloudflare && pnpm run smoke:cloudflare",
    "typecheck": "nuxt typecheck",
    "typecheck:core": "tsc6 --project tsconfig.core.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm run test:node && pnpm run test:unit",
    "test:node": "node --test tests/node/*.test.mjs",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "verify:contracts": "node scripts/verify-contracts.mjs",
    "verify:stage0": "node scripts/verify-stage0.mjs && node scripts/verify-contracts.mjs && node --test tests/node/*.test.mjs",
    "verify:stage0:ci": "node scripts/verify-stage0.mjs --require-lock && node scripts/verify-contracts.mjs && node --test tests/node/*.test.mjs",
    "quality": "pnpm run verify:stage0:ci && pnpm run typecheck && pnpm run lint && pnpm run test:unit",
    "check": "pnpm run quality",
    "acceptance": "pnpm run quality && pnpm run acceptance:ubuntu && pnpm run acceptance:cloudflare && pnpm run test:e2e",
    "db:generate": "node scripts/db/generate-schema.mjs",
    "db:check": "node scripts/db/generate-schema.mjs --check",
    "db:manifest": "node scripts/db/update-manifest.mjs",
    "db:migrate:sqlite": "node scripts/db/migrate.mjs",
    "db:plan:sqlite": "node scripts/db/migrate.mjs --plan",
    "db:migrate:d1:local": "node scripts/db/d1.mjs --local",
    "db:plan:d1:local": "node scripts/db/d1.mjs --local --list",
    "typecheck:database": "tsc6 -p tsconfig.database.full.json",
    "test:database:native": "vitest run --config vitest.database.config.ts",
    "test:database:workerd": "vitest run --config vitest.workerd.config.ts",
    "verify:stage1:offline": "node scripts/verify-stage1.mjs",
    "verify:stage1": "node scripts/verify-stage1-release.mjs",
    "acceptance:stage1": "pnpm run verify:stage1 && pnpm run acceptance",
    "typecheck:security": "tsc6 -p tsconfig.security.json",
    "typecheck:security:http": "tsc6 -p tsconfig.security-http.json",
    "auth:bootstrap:sqlite": "tsx scripts/auth/bootstrap-admin.ts",
    "verify:stage2:offline": "node scripts/verify-stage2.mjs",
    "verify:stage2": "node scripts/verify-stage2-release.mjs",
    "acceptance:stage2": "pnpm run verify:stage2 && pnpm run acceptance",
    "auth:generate-secrets": "node scripts/auth/generate-secrets.mjs",
    "test:security:offline": "node scripts/run-security-tests.mjs",
    "typecheck:stage3": "tsc6 -p tsconfig.stage3.json --noEmit && tsc6 -p tsconfig.stage3-http.json",
    "test:stage3:offline": "node scripts/run-stage3-tests.mjs",
    "verify:stage3:offline": "node scripts/verify-stage3.mjs",
    "verify:stage3": "node scripts/verify-stage3-release.mjs",
    "acceptance:stage3": "pnpm run verify:stage3 && pnpm run acceptance",
    "typecheck:stage4": "tsc6 -p tsconfig.stage4.json --noEmit && tsc6 -p tsconfig.stage4-http.json --noEmit",
    "test:stage4:offline": "node scripts/run-stage4-tests.mjs",
    "verify:stage4:offline": "node scripts/verify-stage4.mjs",
    "verify:stage4": "node scripts/verify-stage4-release.mjs",
    "acceptance:stage4": "pnpm run verify:stage4",
    "typecheck:stage5": "tsc6 -p tsconfig.stage5.json --noEmit && tsc6 -p tsconfig.stage5-http.json --noEmit",
    "test:stage5:offline": "node scripts/run-stage5-tests.mjs",
    "verify:stage5:offline": "node scripts/verify-stage5.mjs",
    "verify:stage5": "node scripts/verify-stage5-release.mjs",
    "acceptance:stage5": "pnpm run verify:stage5",
    "db:seed:sample": "tsx scripts/db/seed-sample.ts",
    "init:windows:demo": "node --import tsx scripts/windows/initialize-local-demo.ts",
    "typecheck:stage6": "tsc6 -p tsconfig.stage6.json --noEmit && tsc6 -p tsconfig.stage6-http.json --noEmit",
    "test:stage6:offline": "node scripts/run-stage6-tests.mjs",
    "verify:stage6:offline": "node scripts/verify-stage6.mjs",
    "verify:stage6": "node scripts/verify-stage6-release.mjs",
    "acceptance:stage6": "pnpm run verify:stage6",
    "verify:release:environment": "node scripts/release/inspect.mjs",
    "verify:release:registry": "node scripts/release/verify-registry.mjs",
    "test:release:tools": "node --test tests/release/*.test.mjs",
    "test:release:native-core": "node scripts/run-release-core.mjs",
    "test:e2e:production": "node scripts/release/production-browser.mjs",
    "test:production:http": "node scripts/release/admin-production-regression.mjs",
    "acceptance:current": "node scripts/release/acceptance.mjs",
    "acceptance:release": "node scripts/release/acceptance.mjs --full",
    "typecheck:production-tests": "tsc6 --project tsconfig.production-tests.json",
    "typecheck:stage26": "tsc6 -p tsconfig.stage26.json --noEmit && tsc6 -p tsconfig.stage26-http.json --noEmit",
    "test:stage26:offline": "node scripts/run-stage26-tests.mjs",
    "verify:stage26:offline": "node scripts/verify-stage26.mjs",
    "verify:stage26": "node scripts/verify-stage26-release.mjs",
    "acceptance:stage26": "pnpm run verify:stage26",
    "typecheck:stage27": "tsc6 -p tsconfig.stage27.json --noEmit && tsc6 -p tsconfig.stage27-http.json --noEmit",
    "test:stage27:offline": "node scripts/run-stage27-tests.mjs",
    "verify:stage27:offline": "node scripts/verify-stage27.mjs",
    "verify:stage27": "node scripts/verify-stage27-release.mjs",
    "acceptance:stage27": "pnpm run verify:stage27",
    "test:complete-admin": "node --test tests/complete-admin/*.test.mjs",
    "verify:complete-admin": "node scripts/verify-complete-admin.mjs",
    "test:backend:complete": "node --test tests/backend/admin-completeness.test.mjs",
    "test:backend:specialists": "node --test tests/backend/admin-specialist-completeness.test.mjs",
    "test:backend:zero-gap": "node --test tests/backend/admin-completeness.test.mjs tests/backend/admin-specialist-completeness.test.mjs",
    "test:backend:full-regression": "node --test tests/backend/admin-full-regression.test.mjs",
    "test:admin-ui-foundation": "node --test tests/backend/admin-ui-foundation.test.mjs",
    "test:admin-list-style": "node --test tests/backend/admin-list-style-regression.test.mjs",
    "test:admin-list-interactions": "node --test tests/backend/admin-list-interactions.test.mjs",
    "test:admin-editor-layout": "node --test tests/backend/admin-editor-layout.test.mjs",
    "test:admin-field-guidance": "node --test tests/backend/admin-field-guidance.test.mjs",
    "test:admin-breadcrumb-links": "node --test tests/backend/admin-breadcrumb-links.test.mjs",
    "test:admin-list-option-controls": "node --test tests/backend/admin-list-option-controls.test.mjs",
    "test:admin-action-column": "node --test tests/backend/admin-action-column-controls.test.mjs",
    "test:admin-media-trash": "node --test tests/backend/admin-media-trash-workflow.test.mjs",
    "test:admin-editor-fields": "node --test tests/backend/admin-editor-fields.test.mjs && vitest run tests/unit/admin-editor-fields.spec.ts"
  },
  "dependencies": {
    "@lucide/vue": "1.35.0",
    "@tanstack/vue-query": "5.102.8",
    "@tiptap/extension-image": "3.4.1",
    "@tiptap/extension-link": "3.4.1",
    "@tiptap/extension-text-align": "3.4.1",
    "@tiptap/extension-underline": "3.4.1",
    "@tiptap/starter-kit": "3.4.1",
    "@tiptap/vue-3": "3.4.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "element-plus": "2.14.5",
    "h3": "1.15.11",
    "nuxt": "4.5.2",
    "nuxt-security": "2.6.0",
    "pdfjs-dist": "6.3.289",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "zod": "4.5.1",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unplugin": "3.3.0",
    "unplugin-element-plus": "0.11.2",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@cloudflare/workers-types": "5.20260825.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "happy-dom": "20.14.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11",
    "wrangler": "4.126.0"
  }
}

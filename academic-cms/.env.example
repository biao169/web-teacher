# Public site metadata
NUXT_PUBLIC_SITE_NAME=Academic CMS
APP_VERSION=0.1.0

# Ubuntu SQLite path. Run migrations before starting the application.
CMS_DATABASE_PATH=data/site.sqlite3

# Nuxt server runtime authentication. Generate independent random values with:
#   pnpm auth:generate-secrets
# Never commit populated secrets.
NUXT_AUTH_SECRET=
NUXT_AUTH_BOOTSTRAP_TOKEN=
NUXT_AUTH_TRUSTED_ORIGINS=http://localhost:3000
NUXT_AUTH_SECURE_COOKIES=false

# Session defaults: 30-minute idle timeout, 8-hour absolute lifetime.
NUXT_AUTH_SESSION_IDLE_SECONDS=1800
NUXT_AUTH_SESSION_ABSOLUTE_SECONDS=28800
NUXT_AUTH_SESSION_TOUCH_SECONDS=300

# Login throttling.
NUXT_AUTH_LOGIN_WINDOW_SECONDS=900
NUXT_AUTH_LOGIN_BLOCK_SECONDS=900
NUXT_AUTH_LOGIN_ACCOUNT_FAILURES=5
NUXT_AUTH_LOGIN_NETWORK_FAILURES=30

# Set only when Node is behind a proxy you operate and trust.
NUXT_AUTH_TRUSTED_PROXY_HOPS=0

# Root language: saved choice > IP country > browser language > fallback.
# Explicit /zh and /en URLs are never redirected by IP.
NUXT_LOCALE_CHINESE_REGIONS=CN,HK,MO,TW
NUXT_LOCALE_FALLBACK=en
# Workers use request.cf.country first. Node uses the socket IP or the trusted
# proxy chain configured above. Never enable proxy trust for a publicly bypassable origin.
# The default country-only HTTPS lookup needs no key; set false to disable it.
NUXT_LOCALE_GEO_IP_ENABLED=true
NUXT_LOCALE_GEO_IP_URL=https://api.country.is
NUXT_LOCALE_GEO_IP_TIMEOUT_MS=1000

# One-time SQLite bootstrap CLI input. The CLI reuses the NUXT_AUTH_* secrets.
CMS_BOOTSTRAP_USERNAME=admin
CMS_BOOTSTRAP_PASSWORD=
CMS_BOOTSTRAP_DISPLAY_NAME=
CMS_BOOTSTRAP_EMAIL=

# Media delivery capability key. Generate independently from NUXT_AUTH_SECRET.
NUXT_MEDIA_GRANT_SECRET=
NUXT_MEDIA_PUBLIC_GRANT_SECONDS=300
NUXT_MEDIA_PRIVATE_GRANT_SECONDS=120
NUXT_MEDIA_ROUTE_BASE=/media
NUXT_MEDIA_ROOT=media
NUXT_STATIC_MEDIA_ROOT=public
NUXT_MEDIA_MAX_OBJECT_BYTES=104857600

# Public ViewModel cache. Cloudflare uses Cache API; Ubuntu uses bounded LRU.
NUXT_CACHE_MAX_ENTRIES=512
NUXT_CACHE_MAX_BYTES=33554432
NUXT_CACHE_MAX_ENTRY_BYTES=2097152
# Required on Cloudflare: trusted canonical HTTPS origin used only to namespace Cache API keys.
# Example: https://www.example.edu
NUXT_CACHE_ORIGIN=

# Canonical public origin shared by SEO, hreflang, robots and /sitemap.xml.
# Set to the real HTTPS domain in production (origin only; no path/query).
# If empty: pages still work; absolute SEO links are omitted and sitemap returns 503.
NUXT_PUBLIC_SITE_URL=
# Development/demo sample data only. The seed command refuses production and non-demo paths.
# Example: CMS_DATABASE_PATH=data/demo-site.sqlite3 pnpm db:migrate:sqlite
#          CMS_DEMO_SEED_ACK=I_UNDERSTAND_THIS_IS_DEMO_ONLY \
#          CMS_DEMO_PASSWORD='replace-with-a-strong-demo-password' \
#          pnpm db:seed:sample -- --database data/demo-site.sqlite3
CMS_DEMO_SEED_ACK=
CMS_DEMO_PASSWORD=

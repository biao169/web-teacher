{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "ES2022.Intl"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "."
  },
  "include": [
    "tests/types/offline-runtime.d.ts",
    "tests/types/stage3-runtime.d.ts",
    "tests/types/stage3-http-runtime.d.ts",
    "tests/types/stage4-http-runtime.d.ts",
    "server/types/h3.d.ts",
    "db/contracts.ts", "db/query.ts", "db/errors.ts", "db/statement.ts",
    "db/codec.ts", "db/catalog.ts", "db/models.ts", "db/schema-types.ts", "db/context.ts", "db/read-plans.ts",
    "db/adapters/sqlite.ts", "db/adapters/d1.ts",
    "shared/enums/*.ts", "shared/contracts/*.ts", "shared/utils/*.ts",
    "server/security/*.ts", "server/audit/*.ts", "server/services/auth/*.ts",
    "server/view-model/*.ts", "server/i18n/*.ts", "server/cache/*.ts", "server/media/*.ts",
    "server/services/i18n/*.ts", "server/services/media/*.ts", "server/services/public/*.ts",
    "server/adapters/media-*.ts", "server/adapters/cache-*.ts",
    "server/utils/database.ts", "server/utils/auth-runtime.ts", "server/utils/cache-runtime.ts",
    "server/utils/i18n-runtime.ts", "server/utils/media-runtime.ts", "server/utils/media-http.ts", "server/utils/public-runtime.ts",
    "server/routes/media/*.ts", "server/routes/api/v1/public/*.ts"
  ]
}
